# Backend
/backend/node_modules/

# Frontend source (React build tool deps)
/frontend-src/node_modules/

# Built frontend assets — regenerated by `npm run build` in frontend-src/
# These are committed so the Express server can serve them without a build step
# on the deployed machine. To exclude them instead, remove this comment and add:
# /frontend/assets/
# /frontend/index.html

# Environment variables — never commit secrets
.env
*.env.local

# macOS
.DS_Store

# Windows
Thumbs.db
